# serial-boot-wrapper Makefile
# Builds an EFI application that mirrors systemd-boot output to serial console

ARCH ?= x86_64
CC ?= gcc
LD ?= ld
OBJCOPY ?= objcopy

# gnu-efi paths
EFIINC ?= /usr/include/efi
EFILIB ?= /usr/lib

# Optional build-time configuration directory containing config.h
# (generated by nix/serial-boot.nix). Leave empty for the built-in defaults.
CONFIGDIR ?=

# Compiler flags for UEFI
CFLAGS = -I$(EFIINC) \
         -I$(EFIINC)/$(ARCH) \
         -I$(EFIINC)/protocol \
         $(if $(CONFIGDIR),-I$(CONFIGDIR) -DCONFIGDIR_PRESENT) \
         -ffreestanding \
         -fshort-wchar \
         -fno-strict-aliasing \
         -Wall \
         -Wextra \
         -mno-red-zone \
         -mno-sse \
         -mno-sse2 \
         -maccumulate-outgoing-args \
         -mno-stack-arg-probe \
         -mcmodel=small \
         -fno-stack-protector \
         -DGNU_EFI_USE_MS_ABI

# Linker flags for UEFI PE/COFF
LDFLAGS = -nostdlib \
         -znocombreloc \
         -T $(EFILIB)/elf_$(ARCH)_efi.lds \
         -shared \
         -Bsymbolic \
         $(EFILIB)/crt0-efi-$(ARCH).o

# Source and output
SRC = serial-boot.c
OBJ = serial-boot.o
EFI_APP = serial-bootx64.efi

.PHONY: all clean

all: $(EFI_APP)

$(OBJ): $(SRC)
	$(CC) $(CFLAGS) -c $< -o $@

# Link to shared object (ELF)
SO_APP = serial-boot.so

$(SO_APP): $(OBJ)
	$(LD) $(LDFLAGS) $< -o $@ $(EFILIB)/libgnuefi.a $(EFILIB)/libefi.a

# Convert ELF to PE/COFF EFI application
$(EFI_APP): $(SO_APP)
	$(OBJCOPY) -I elf64-x86-64 -j .text -j .sdata -j .data -j .dynamic -j .dynsym -j .rel -j .rela -j .reloc --output-target=efi-app-x86-64 $< $@

clean:
	rm -f $(OBJ) $(SO_APP) $(EFI_APP) $(EFI_APP).debug
